#!/usr/bin/bash

set -euxo pipefail

# shellcheck disable=SC1091
. /bin/configure-ironic.sh

# NOTE(nuhakala): The variables are hardcoded here for the purpose of enabling
# the configuration generation transfer into its own container. Once the
# transfer is done, the ironic container will expect to find configuration in
# the following paths.
BMC_CACERTS_PATH="/certs/ca/bmc"
IRONIC_CONF_DIR="/conf/ironic"
BMC_CACERT_FILE="/conf/ironic/bmc-tls.pem"

if ls "${BMC_CACERTS_PATH}"/* > /dev/null 2>&1; then
	echo "BMC TLS enabled, watching ${BMC_CACERTS_PATH} for certificates"
    # shellcheck disable=SC2016
    watchmedo shell-command \
        --patterns="*" \
        --ignore-directories \
        --command='tmp=$(mktemp "${BMC_CACERT_FILE}.XXXXXX") && cat "${BMC_CACERTS_PATH}"/* > "${tmp}" && mv "${tmp}" "${BMC_CACERT_FILE}"' \
        "${BMC_CACERTS_PATH}" &
fi

exec /usr/bin/ironic --config-dir "${IRONIC_CONF_DIR}"
