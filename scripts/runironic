#!/usr/bin/bash

# ------------------------------------------------------------------------------
# Ironic entrypoint script.
#
# Parses configuration from an environment file, synchronizes the database,
# sets up TLS certificate watching, and starts the ironic service.
#
# Configuration variables can be provided through environment or through the
# specific environment variable file. The file will take precedence. If the
# file and environment have conflicting values, warning will be printed and
# execution stops by default. The behavior can be configured with
# ERR_ON_CONFLICT.
#
# Locations for configuration:
#
#	BMC CA certificate dir	/certs/ca/bmc
#	Ironic env file	        /conf/ironic.env
#
# Configuration variables (set via /conf/ironic/ironic.env):
#
#   ERR_ON_CONFLICT          If "true", abort when a variable from the env file
#                            conflicts with one already set in the environment.
#                            Default: true
#   IRONIC_SKIP_DBSYNC       If "true", skip the database synchronization step.
#                            Default: false
#   IRONIC_USE_MARIADB       If "true", use MariaDB backend with retry logic.
#                            If "false", use SQLite. Default: false
#   IRONIC_DBSYNC_TIMEOUT    Timeout in seconds for MariaDB dbsync retries.
#                            Default: 600
#   IRONIC_DBSYNC_INTERVAL   Seconds between MariaDB dbsync retry attempts.
#                            Default: 1
#   IRONIC_CONF_DIR          Path to look for Ironic configuration. Default:
#                            /conf/ironic.
#   IRONIC_DB_DIR            Path to look for SQLite database. Default:
#                            /data/db.
# ------------------------------------------------------------------------------

set -euxo pipefail

# shellcheck disable=SC1091
. /bin/configure-ironic.sh

# ***** Parse env file to configure this entrypoint *****
ENV_FILE="/conf/ironic.env"
CONFLICT_FOUND=false
if [[ -f ${ENV_FILE} ]]; then
	while IFS='=' read -r KEY VALUE || [[ -n "${KEY}" ]]; do
		# Filter empty lines and comments
		[[ -z "$KEY" || "$KEY" == \#* ]] && continue
		if env | grep -q "^${KEY}="; then
			echo "WARNING! Variable ${KEY} is already set in the environment, overwriting"
			CONFLICT_FOUND=true
		fi
		export "${KEY}=${VALUE}"
	done < "${ENV_FILE}"
else
	echo "No environment file provided, continuing with defaults."
fi
ERR_ON_CONFLICT="${ERR_ON_CONFLICT:-true}"
if [[ ${ERR_ON_CONFLICT,,} == "true" ]] && [[ ${CONFLICT_FOUND} == "true" ]]; then
	echo "Error on conflict configured and conflict found, aborting"
	exit 1
fi

# ***** Synchronize DB *****
IRONIC_SKIP_DBSYNC="${IRONIC_SKIP_DBSYNC:-false}"
IRONIC_DBSYNC_TIMEOUT="${IRONIC_DBSYNC_TIMEOUT:-600}"
IRONIC_DBSYNC_INTERVAL="${IRONIC_DBSYNC_INTERVAL:-1}"
IRONIC_USE_MARIADB="${IRONIC_USE_MARIADB:-false}"
IRONIC_DB_DIR="${IRONIC_DB_DIR:-/data/db}"
IRONIC_CONF_DIR="${IRONIC_CONF_DIR:-/conf/ironic}"

if [[ "${IRONIC_SKIP_DBSYNC}" != true ]]; then
    if [[ "${IRONIC_USE_MARIADB}" == "true" ]]; then
        # It's possible for the dbsync to fail if mariadb is not up yet, so
        # retry until success
        deadline=$(( SECONDS + IRONIC_DBSYNC_TIMEOUT ))
        until ironic-dbsync --config-file "${IRONIC_CONF_DIR}/ironic.conf" upgrade; do
			if (( IRONIC_DBSYNC_TIMEOUT > 0 )) && (( SECONDS >= deadline )); then
				echo "ERROR: timed out after ${IRONIC_DBSYNC_TIMEOUT}s waiting for" \
				     "ironic-dbsync to succeed (is MariaDB reachable?)" >&2
				exit 1
			fi
            echo "WARNING: ironic-dbsync failed, retrying"
            sleep "${IRONIC_DBSYNC_INTERVAL}"
        done
    else
        # SQLite does not support some statements. Fortunately, we can just
        # create the schema in one go if not already created, instead of going
        # through an upgrade
        cp "/var/lib/ironic/ironic.sqlite" "${IRONIC_DB_DIR}/ironic.sqlite"
        DB_VERSION="$(ironic-dbsync --config-file "${IRONIC_CONF_DIR}/ironic.conf" version)"
        if [[ "${DB_VERSION}" == "None" ]]; then
            ironic-dbsync --config-file "${IRONIC_CONF_DIR}/ironic.conf" create_schema
        fi
    fi
fi

# ***** TLS handling *****
export BMC_CACERT_FILE="/conf/bmc-tls.pem"
export BMC_CACERTS_PATH="/certs/ca/bmc"
if ls "${BMC_CACERTS_PATH}"/* > /dev/null 2>&1; then
	echo "BMC TLS enabled, watching ${BMC_CACERTS_PATH} for certificates"
    # shellcheck disable=SC2016
    watchmedo shell-command \
        --patterns="*" \
        --ignore-directories \
        --command='tmp=$(mktemp "${BMC_CACERT_FILE}.XXXXXX") && cat "${BMC_CACERTS_PATH}"/* > "${tmp}" && mv "${tmp}" "${BMC_CACERT_FILE}"' \
        "${BMC_CACERTS_PATH}" &
fi

# ***** Start ironic *****
exec /usr/bin/ironic --config-dir "${IRONIC_CONF_DIR}"
